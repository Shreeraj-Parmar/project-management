# ---- Required ----
# Single password used to unlock the whole workspace (no accounts).
APP_PASSWORD=change-me

# Random string (32+ chars) used to sign the login session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# 64 hex characters (32 bytes). Used to AES-256-GCM encrypt env values & passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/devboard

# ---- Optional: AWS S3 (Files module) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- Optional: GitHub (Git module) ----
# Personal access token with `repo` read scope so private repos can be read.
GITHUB_TOKEN=
